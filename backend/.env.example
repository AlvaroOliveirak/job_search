# Back-end (Spring Boot) — variáveis OPCIONAIS em desenvolvimento.
# O Spring não lê este arquivo sozinho: exporte as variáveis no terminal antes de
#   ./mvnw spring-boot:run
# PowerShell:  $env:JWT_SECRET="..."; $env:SYNC_TOKEN="..."
# Bash:        export JWT_SECRET=... SYNC_TOKEN=...

# Chave de assinatura dos tokens JWT em Base64 (mínimo 256 bits).
# Sem ela, é usada uma chave de desenvolvimento definida em application.properties.
JWT_SECRET=

# Token interno do endpoint /api/jobs/sync (Python -> Spring Boot).
# Sem ele, o back-end gera um token aleatório a cada inicialização e o repassa ao
# Python automaticamente. Defina-o apenas para rodar o pipeline Python manualmente.
SYNC_TOKEN=
