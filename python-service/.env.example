# Pipeline Python — variáveis usadas ao rodar main.py MANUALMENTE.
# O main.py não lê este arquivo: exporte as variáveis no terminal antes de rodar.
# Quando o pipeline é disparado pelo botão "Atualizar Vagas", o Spring Boot já
# repassa o SYNC_TOKEN automaticamente.

# Mesmo valor de SYNC_TOKEN usado ao iniciar o back-end
SYNC_TOKEN=

# URL do back-end Spring Boot
SPRING_API_URL=http://localhost:8082
